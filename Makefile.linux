# Native Linux entry point. The existing desktop binary remains a test runner.
# No dependencies are downloaded and no external client applications are launched.
.DEFAULT_GOAL := all
# These must precede the include: Make expands rule targets while parsing it.
override BUILD := build/linux
override TARGET := $(BUILD)/LunarNX_Desktop
include Makefile.desktop

# Override Apple-specific flags without changing the macOS/Switch build paths.
SDK_PATH :=
PKG_CONFIG ?= pkg-config
LINUX_PACKAGES := sdl2 libavcodec libavutil libswresample opus libcurl openssl
COMMON_INCLUDES = -Isrc -Ilib \
    -Ilib/libpeer/third_party/mbedtls/include \
    -Ilib/libpeer/third_party/libsrtp/include \
    -Ilib/libpeer/third_party/libsrtp/crypto/include \
    -idirafter lib/libpeer/include -idirafter lib/libpeer/include/sys \
    -Ilib/libpeer/src -Ilib/libpeer/build/dist/include \
    -Ilib/libpeer/build/dist/include/srtp2 \
    -Ilib/libpeer/third_party/coreHTTP/source/interface \
    $(shell $(PKG_CONFIG) --cflags $(LINUX_PACKAGES))

# Do not filter Linux network interfaces using macOS's en0 name.
COMMON_DEFINES := $(filter-out -DCONFIG_IFACE_PREFIX=%,$(COMMON_DEFINES))
COMMON_DEFINES += -DCONFIG_IFACE_PREFIX=\"\"
CXXFLAGS = -std=gnu++17 -O2 -g -Wall -pthread $(COMMON_INCLUDES) $(COMMON_DEFINES)
CFLAGS = -O2 -g -Wall -pthread $(COMMON_INCLUDES) $(COMMON_DEFINES)
LDFLAGS = -pthread \
    -Llib/libpeer/third_party/mbedtls/build_host/library \
    -Llib/libpeer/third_party/libsrtp/build_host \
    -Llib/libpeer/build/dist/lib \
    $(shell $(PKG_CONFIG) --libs $(LINUX_PACKAGES)) \
    -lmbedtls -lmbedx509 -lmbedcrypto -lsrtp2
.PHONY: linux-check-dependencies
linux-check-dependencies:
	@$(PKG_CONFIG) --exists $(LINUX_PACKAGES) || \
	    { echo "Missing Linux development packages: $(LINUX_PACKAGES)" >&2; exit 1; }
	@test -f lib/libpeer/src/peer_connection.c || \
	    { echo "Prepare the pinned legacy libpeer dependency before the full build." >&2; exit 1; }

all: linux-check-dependencies

# Desktop-only diagnostic helpers also need native Linux libraries.
http_client_cancel_tests:
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -o $(BUILD)/http_client_cancel_test $(HTTP_CLIENT_CANCEL_TEST_OBJS) $(shell $(PKG_CONFIG) --libs libcurl)
	./$(BUILD)/http_client_cancel_test

auth_refresh_cancel_tests:
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -o $(BUILD)/auth_refresh_cancel_test $(AUTH_REFRESH_CANCEL_TEST_OBJS) $(shell $(PKG_CONFIG) --libs libcurl openssl)
	./$(BUILD)/auth_refresh_cancel_test

audio_decoder_tests:
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -o $(BUILD)/audio_decoder_plc_test $(AUDIO_DECODER_TEST_OBJS) $(shell $(PKG_CONFIG) --libs opus)
	./$(BUILD)/audio_decoder_plc_test

rho:
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) -o $(BUILD)/rho $(RHO_OBJS) $(shell $(PKG_CONFIG) --libs mpv)

.PHONY: linux-toolchain-report
linux-toolchain-report:
	@printf '%s\n' 'CXXFLAGS=$(CXXFLAGS)' 'LDFLAGS=$(LDFLAGS)' 'TARGET=$(TARGET)'
